# Copier ce fichier en .env puis remplir les valeurs.
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Clé de signature des JWT, distincte de DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
# Secret partagé avec le serveur Next (même valeur dans frontend/.env.local).
BFF_SHARED_SECRET=
FRONTEND_URL=http://localhost:3000
# Inscription : 1 = lien de confirmation par e-mail, sans révéler qui a un compte (par défaut ; en développement,
# l'e-mail s'affiche dans le terminal de Django) ; 0 = en une étape, sans e-mail, mais une adresse prise est révélée.
SIGNUP_EMAIL_VERIFICATION=1
# Par défaut, les e-mails de développement s'affichent dans le terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# E-mails de notification (commandes, stock bas, résumé du jour). 0 par défaut ; voir docs/chantier-a2-notifications.md §10.
NOTIFICATIONS_ENABLED=0
# En production : django.core.mail.backends.smtp.EmailBackend, puis les réglages du service d'envoi (valeurs hors de Git).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_TIMEOUT=5
# L'expéditeur doit être sur un domaine que vous possédez (SPF, DKIM, DMARC), par exemple : Akwaba <notifications@votre-domaine>
DJANGO_DEFAULT_FROM_EMAIL=
# En production, choisir un chemin difficile à deviner, par exemple gestion-7k2p/
DJANGO_ADMIN_URL=admin/
# Clé Fernet qui chiffre les secrets 2FA :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
# Clé qui signe la chaîne du journal d'audit. Ne jamais la changer : l'historique ne se vérifierait plus.
AUDIT_HMAC_KEY=
