# Copier en .env.local et remplir. Ces valeurs ne sont lues que côté serveur (jamais NEXT_PUBLIC_).
# Adresse de l'API Django, appelée de serveur à serveur.
API_URL=http://127.0.0.1:8000
# Même valeur que BFF_SHARED_SECRET dans backend/.env : prouve à Django que l'appel vient du BFF.
BFF_SHARED_SECRET=
